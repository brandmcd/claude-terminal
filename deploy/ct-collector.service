[Unit]
Description=claude-terminal usage collector (transcripts -> usage.db)
After=ct-sidecar.service

[Service]
Type=oneshot
User=ctuser
WorkingDirectory=/srv/claude-terminal
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/bun run collector.ts /etc/claude-terminal/config.json
# The collector only reads transcripts and writes usage.db; it needs no privilege.
NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=full
ReadWritePaths=/var/lib/claude-terminal
